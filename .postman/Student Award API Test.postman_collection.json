  "item": [
    {
      "name": "Log Volunteer Hours",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 or 201\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\npm.test(\"Response time is less than 2000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});\n\npm.test(\"Response body is not empty\", function () {\n    pm.expect(pm.response.text()).to.not.be.empty;\n});\n\npm.test(\"Response JSON contains expected fields\", function () {\n    try {\n        const jsonData = pm.response.json();\n        pm.expect(jsonData).to.satisfy(function (data) {\n            return data.hasOwnProperty('id') || data.hasOwnProperty('message') || data.hasOwnProperty('success');\n        });\n    } catch (e) {\n        // Response is not JSON, skip this test\n        pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.not.include(\"application/json\");\n    }\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "activity_description",
              "value": "Helping Event"
            },
            {
              "key": "hours",
              "value": "5"
            },
            {
              "key": "log_date",
              "value": "2026-11-09"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/app/log-hours",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "app",
            "log-hours"
          ]
        }
      },
      "response": []
